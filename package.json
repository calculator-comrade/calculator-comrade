{
  "name": "calculator-comrade",
  "private": true,
  "version": "2.0.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "version": "node scripts/sync-app-version.js",
    "version:sync": "node scripts/sync-app-version.js",
    "start": "npm run start:web",
    "start:web": "vite",
    "build:web": "tsc -b && vite build",
    "preview:web": "vite preview",
    "build:pages": "tsc -b && vite build --mode pages && vite build --mode pages --ssr src/site/entry-server.tsx --outDir dist/pages/.ssg && node scripts/generate-pages.js && npm run test:ssg",
    "preview:pages": "vite preview --mode pages",
    "build:android:web-assets": "tsc -b && vite build --mode android",
    "sync:android": "npm run build:android:web-assets && cap sync android",
    "build:android:aab": "node scripts/build-android-aab.js",
    "analyze:android:aab": "node scripts/analyze-android-aab.js",
    "convert:android:aab-to-apk": "node scripts/convert-android-aab-to-apk.js",
    "open:android:studio": "cap open android",
    "start:desktop:dev-server": "vite --mode desktop --host 127.0.0.1 --port 5174 --strictPort",
    "start:desktop": "tauri dev",
    "build:desktop:web-assets": "tsc -b && vite build --mode desktop",
    "build:desktop:linux": "tauri build --bundles deb,appimage",
    "build:desktop:windows": "tauri build --bundles nsis",
    "lint": "eslint .",
    "test:ssg": "node scripts/check-pages-ssg.js"
  },
  "dependencies": {
    "@capacitor/android": "~8.4.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "~8.4.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@fontsource/orbitron": "^5.2.8",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.4.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.16"
  },
  "description": "Calculator Comrade web app, site, and future multiplatform shell."
}
