# Copy to android/keystore.properties (ignored by Git).
# Paths are absolute, or relative to the android/ directory.
# Use forward slashes in Windows paths (e.g. C:/Users/.../release_keystore.jks).
# Passwords can use ${env:VARIABLE_NAME} or a literal value (legacy mode).
# Environment variables must be present in the process running npm/Gradle.
# Never commit the private keystore or this local credentials file.
storeFile=/absolute/path/to/release_keystore.jks
storePassword=${env:CC_ANDROID_STORE_PASSWORD}
keyAlias=YOUR_UPLOAD_KEY_ALIAS
keyPassword=${env:CC_ANDROID_KEY_PASSWORD}
uploadCertificate=/absolute/path/to/upload_certificate.pem
